# Скопируйте в .env и задайте свои значения. .env в git не попадает.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jade_archive
MYSQL_USER=jade_user
MYSQL_PASSWORD=change-me

# Для запуска бэкенда вне Docker (тесты используют свою базу, см. docs/development.md)
DATABASE_URL=mysql+pymysql://jade_user:change-me@localhost:3306/jade_archive?charset=utf8mb4

# Telegram-бот (backend/bot.py, backend/run_bot.py)
BOT_TOKEN=
PROXY_URL=socks5://127.0.0.1:1080
